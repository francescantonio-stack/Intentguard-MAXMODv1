# Copy to .env.local (gitignored). TESTNET ONLY. Never paste real/mainnet keys.
# Secrets stay empty in git. Public testnet defaults below are safe to commit.

# =============================================================================
# PWA / Vercel (apps/web)
# Set these in Vercel → Settings → Environment Variables (Production + Preview).
# HTTPS is required for real passkeys; *.vercel.app provides it.
# None of these are required: the app has testnet defaults and a rules-parser fallback.
# =============================================================================

# --- Public (safe; NEXT_PUBLIC_* is inlined into the browser bundle) ---
# Deployed NEAR testnet policy (deployments/near-testnet.json). Leave unset to use the same default.
NEXT_PUBLIC_POLICY_CONTRACT_ID=intentguard-973f6c.testnet

# Optional: pin WebAuthn rpId to a stable host (e.g. your-app.vercel.app).
# Must be equal to, or a registrable suffix of, the hostname the user visits.
# Leave empty so the PWA uses window.location.hostname (localhost and any Vercel URL).
NEXT_PUBLIC_RP_ID=

# Optional: public origin of the deployed PWA (MCP approval links + SSR fallback).
# On Vercel, VERCEL_URL is set automatically. Set this only for a custom domain.
NEXT_PUBLIC_APP_URL=

# Optional: browser RPC overrides. Default is same-origin /api/rpc/* (recommended).
NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# --- Server-only (Next.js route handlers). NEVER prefix these with NEXT_PUBLIC_. ---
# LLM keys are optional: with no key the deterministic rules parser still handles the demo command.
LLM_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Upstream RPCs used by /api/rpc/*, /api/guard and /api/cctp (testnet only).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
CIRCLE_IRIS_API_URL=https://iris-api-sandbox.circle.com

# =============================================================================
# Local scripts / contracts / MCP (NOT needed on Vercel; never put keys there)
# =============================================================================
MPC_CONTRACT_ID=v1.signer-prod.testnet
POLICY_CONTRACT_ID=intentguard-973f6c.testnet
# Deployer: prefer `cast wallet import <name> --interactive` (Foundry keystore) over a raw key
DEPLOYER_ACCOUNT_NAME=
NEAR_ACCOUNT_ID=
# MCP server for AI agents (packages/mcp): no keys at all
NEAR_USER=
APP_URL=
